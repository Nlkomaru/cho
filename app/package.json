{
  "name": "cho",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm run generate-licenses && vp dev --port 3000",
    "generate-licenses": "pnpm licenses list --prod --json | node scripts/generate-license-data.mjs && vp fmt src/routes/_app/license/-data.json",
    "generate-routes": "tsr generate",
    "build": "pnpm run generate-licenses && vp build",
    "preview": "pnpm run build && vp preview",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.31.0",
    "@emotion/react": "^11.14.0",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@fontsource/noto-sans-jp": "^5.2.6",
    "@fontsource/poppins": "^5.2.6",
    "@hono/mcp": "^0.3.5",
    "@hono/zod-openapi": "^1.1.5",
    "@internationalized/date": "^3.12.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@scalar/hono-api-reference": "^0.9.26",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.11.4",
    "jose": "^6.2.16",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@pandacss/dev": "^0.53.7",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.8",
    "typescript": "^6.0.2",
    "vite-plus": "latest",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.126.0"
  }
}
